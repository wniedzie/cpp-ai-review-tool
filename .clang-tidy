---
Checks: >
  clang-diagnostic-*,
  clang-analyzer-*,
  bugprone-*,
  cppcoreguidelines-*,
  modernize-*,
  performance-*,
  readability-*,
  -modernize-use-trailing-return-type,
  -readability-magic-numbers,
  -readability-function-cognitive-complexity,
  -cppcoreguidelines-avoid-magic-numbers,
  -bugprone-easily-swappable-parameters,
  -performance-unnecessary-value-param,
  -cppcoreguidelines-non-private-member-variables-in-classes

WarningsAsErrors: '*'

HeaderFilterRegex: '^(include|src)/.*'

# Clang 18 reports __cpp_concepts=201907L (Concepts TS value), but GCC 13's
# libstdc++ <expected> guards its content with __cpp_concepts >= 202002L
# (the C++20 final value).  Override to the correct value so that
# std::expected (and other C++23 features guarded the same way) are visible
# to clang-tidy.  -Wno-builtin-macro-redefined suppresses the diagnostic
# that Clang emits when a built-in feature-test macro is redefined.
ExtraArgsBefore:
  - '-Wno-builtin-macro-redefined'
  - '-D__cpp_concepts=202002L'
